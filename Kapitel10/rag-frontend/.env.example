# Umgebungsvariablen für RAG-Frontend
# Kapitel 10: RAG-Frontend & Zugriffskontrolle
#
# Kopieren zu .env und anpassen

# JWT Secret (in Produktion: sicheren Wert generieren!)
JWT_SECRET=change-this-to-a-secure-random-string

# JWT Token Gültigkeit
JWT_EXPIRES_IN=8h

# Ollama Konfiguration
OLLAMA_URL=http://localhost:11434
RAG_MODEL=llama3.2

# CORS (Frontend URL)
CORS_ORIGIN=http://localhost:3000

# Backend Port
PORT=3001
